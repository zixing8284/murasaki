{
  "name": "@murasaki-io/react98-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "play": "pnpm --filter @murasaki-io/react98-playground dev",
    "play:build": "pnpm --filter @murasaki-io/react98-playground build",
    "play:preview": "pnpm --filter @murasaki-io/react98-playground preview",
    "docs:dev": "pnpm --filter @murasaki-io/react98-docs dev",
    "docs:build": "pnpm --filter @murasaki-io/react98-docs build",
    "docs:embed": "node scripts/embed-docs.mjs",
    "docs:build:embed": "pnpm docs:build && pnpm docs:embed",
    "docs:preview": "pnpm --filter @murasaki-io/react98-docs preview",
    "ui:build": "pnpm --filter @murasaki-io/react98 build",
    "ui:build:docs": "pnpm ui:build && pnpm docs:build:embed",
    "ui:dev": "pnpm --filter @murasaki-io/react98 dev",
    "ui:test": "pnpm --filter @murasaki-io/react98 test",
    "ui:test:watch": "pnpm --filter @murasaki-io/react98 test:watch",
    "tokens:build": "pnpm --filter @murasaki-io/tokens build",
    "tokens:dev": "pnpm --filter @murasaki-io/tokens dev",
    "lint": "pnpm eslint .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "cd packages/ui && pnpm publish --no-git-checks --provenance --access public",
    "skills:update": "pnpm dlx skills add vercel-labs/agent-skills",
    "react-doctor": "pnpm dlx react-doctor@latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:root",
    "@changesets/cli": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:root",
    "@tsconfig/strictest": "catalog:root",
    "eslint": "catalog:root",
    "eslint-plugin-react-hooks": "catalog:root",
    "eslint-plugin-react-refresh": "catalog:root",
    "typescript": "catalog:cli"
  }
}
