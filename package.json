{
  "name": "@murasaki/react98-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
  "scripts": {
    "play": "pnpm --filter @murasaki/react98-playground dev",
    "play:build": "pnpm --filter @murasaki/react98-playground build",
    "play:preview": "pnpm --filter @murasaki/react98-playground preview",
    "docs:dev": "pnpm --filter @murasaki/react98-docs dev",
    "docs:build": "pnpm --filter @murasaki/react98-docs build",
    "docs:embed": "node scripts/embed-docs.mjs",
    "docs:build:embed": "pnpm docs:build && pnpm docs:embed",
    "docs:preview": "pnpm --filter @murasaki/react98-docs preview",
    "ui:build": "pnpm --filter @murasaki/react98 build",
    "ui:build:docs": "pnpm ui:build && pnpm docs:build:embed",
    "ui:dev": "pnpm --filter @murasaki/react98 dev",
    "ui:test": "pnpm --filter @murasaki/react98 test",
    "ui:test:watch": "pnpm --filter @murasaki/react98 test:watch",
    "lint": "pnpm eslint .",
    "release": "pnpm ui:build && cd packages/ui && bumpp",
    "skills:update": "npx skills add vercel-labs/agent-skills",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:root",
    "@eslint-react/eslint-plugin": "catalog:root",
    "@tsconfig/strictest": "catalog:root",
    "eslint": "catalog:root",
    "eslint-plugin-react-hooks": "catalog:root",
    "eslint-plugin-react-refresh": "catalog:root",
    "typescript": "catalog:cli"
  }
}
