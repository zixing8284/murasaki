{
  "name": "@murasaky/react98-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "play": "pnpm --filter @murasaky/react98-playground dev",
    "play:build": "pnpm --filter @murasaky/react98-playground build",
    "play:preview": "pnpm --filter @murasaky/react98-playground preview",
    "docs:dev": "pnpm --filter @murasaky/react98-docs dev",
    "docs:build": "pnpm --filter @murasaky/react98-docs build",
    "docs:embed": "node scripts/embed-docs.mjs",
    "docs:build:embed": "pnpm docs:build && pnpm docs:embed",
    "docs:preview": "pnpm --filter @murasaky/react98-docs preview",
    "ui:build": "pnpm --filter @murasaky/react98 build",
    "ui:build:docs": "pnpm ui:build && pnpm docs:build:embed",
    "ui:dev": "pnpm --filter @murasaky/react98 dev",
    "ui:test": "pnpm --filter @murasaky/react98 test",
    "ui:test:watch": "pnpm --filter @murasaky/react98 test:watch",
    "lint": "pnpm eslint .",
    "release": "pnpm ui:build && cd packages/ui && bumpp",
    "skills:update": "npx skills add vercel-labs/agent-skills",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:root",
    "@eslint-react/eslint-plugin": "catalog:root",
    "@tsconfig/strictest": "catalog:root",
    "eslint": "catalog:root",
    "eslint-plugin-react-hooks": "catalog:root",
    "eslint-plugin-react-refresh": "catalog:root",
    "typescript": "catalog:cli"
  }
}
