{
  "name": "murasaki-react98",
  "version": "0.0.0",
  "type": "module",
  "description": "A Windows 98-themed UI component library built with React and Tailwind CSS",
  "author": "sasasa10 <zixing8284@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sasasa10/murasaki-react98#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasasa10/murasaki-react98.git"
  },
  "bugs": {
    "url": "https://github.com/sasasa10/murasaki-react98/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./globals.css": "./dist/globals.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^6.1.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "bumpp": "^10.3.2",
    "tsdown": "^0.18.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vitest-browser-react": "^2.0.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  }
}
