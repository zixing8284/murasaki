{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "jsx": "preserve",
    "module": "esnext",
    "plugins": [
      { "name": "next" }
    ],
    "types": ["node"],
    "allowJs": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mdx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
