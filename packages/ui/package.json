{
  "name": "@murasaki/react98",
  "type": "module",
  "version": "0.0.0",
  "description": "A Windows 98-themed React UI component library published as @murasaki/react98",
  "author": "sasasa10 <zixing8284@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/zixing8284/murasaki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixing8284/murasaki.git"
  },
  "bugs": {
    "url": "https://github.com/zixing8284/murasaki/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./globals.css": "./dist/globals.css",
    "./theme.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "style": "./dist/globals.css",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/assets",
    "src/theme.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.styles.config.ts && tsc --emitDeclarationOnly",
    "build:css": "vite build --config vite.styles.config.ts",
    "build:js": "vite build",
    "dev": "pnpm run dev:js & pnpm run dev:css & wait",
    "dev:css": "vite build --config vite.styles.config.ts --watch",
    "dev:js": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "catalog:libs",
    "react-dom": "catalog:libs"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "catalog:cli",
    "@tailwindcss/vite": "catalog:cli",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:cli",
    "@vitest/browser-playwright": "catalog:cli",
    "babel-plugin-react-compiler": "catalog:cli",
    "bumpp": "catalog:cli",
    "react": "catalog:libs",
    "react-dom": "catalog:libs",
    "tailwindcss": "catalog:libs",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:cli",
    "vitest-browser-react": "catalog:cli"
  }
}
